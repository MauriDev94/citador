# ─────────────────────────────────────────────
# Citador — configuración de entorno
#
# Copia este archivo a `.env` y completa los valores.
#   cp .env.example .env
#
# `.env` está gitignoreado y NUNCA debe versionarse.
# Acá van solo PLACEHOLDERS: ni una credencial real, ni de dev local.
# ─────────────────────────────────────────────

# Puerto local de la API
POSTGRES_USER=citador
POSTGRES_PASSWORD=changeme
POSTGRES_DB=citador

DATABASE_URL=postgresql+asyncpg://citador:changeme@localhost:5432/citador
TEST_DATABASE_URL=postgresql+asyncpg://citador:changeme@localhost:5433/citador_test
PORT=8000